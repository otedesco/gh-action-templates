{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["statements", "branches", "functions", "lines"],
        "properties": {
          "statements": { "$ref": "#/$defs/metric" },
          "branches": { "$ref": "#/$defs/metric" },
          "functions": { "$ref": "#/$defs/metric" },
          "lines": { "$ref": "#/$defs/metric" }
        }
      }
    }
  },
  "$defs": { "metric": { "type": "object", "required": ["covered", "total"], "properties": { "covered": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } } }
}
