{
  "version": 1,
  "owner": "otedesco",
  "defaultBranch": "main",
  "repositories": [
    {
      "name": "gh-action-templates",
      "fullName": "otedesco/gh-action-templates",
      "localPath": ".",
      "defaultBranch": "main",
      "protectedBranch": "main",
      "codeowners": ".github/CODEOWNERS",
      "owners": ["otedesco"],
      "requiredPaths": [
        ".github/**",
        "governance/**",
        "quality-gates/**",
        "security/**",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "workflows": [
        ".github/workflows/quality-checks.yml",
        ".github/workflows/security.yml",
        ".github/workflows/lint-and-test.yml"
      ],
      "requiredChecks": [
        {
          "context": "Quality / core",
          "workflow": ".github/workflows/quality-checks.yml",
          "job": "quality-gate",
          "observed": false
        },
        {
          "context": "Security / aggregate",
          "workflow": ".github/workflows/quality-checks.yml",
          "job": "security-gate",
          "observed": false
        }
      ],
      "bypassActors": []
