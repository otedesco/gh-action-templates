{
  "name": "@otedesco/quality-gates-foundation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.34.0"
  },
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "format": "prettier \"**/*.{js,mjs,cjs,json}\" --write",
    "format:check": "prettier \"**/*.{js,mjs,cjs,json}\" --check",
    "lint:workflows": "node-actionlint .github/workflows/*.yml",
    "lint:js": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:json": "node scripts/check-json.mjs",
    "lint:check": "pnpm run lint:js && pnpm run lint:json",
    "test:action-references": "node --test test/action-references.test.mjs && node scripts/audit-action-references.mjs",
    "test:runtime-contract": "node --test test/runtime-contract.test.mjs",
    "test:registry-auth": "node --test test/registry-auth.test.mjs",
    "test:quality-script-contract": "node --test test/quality-script-contract.test.mjs",
    "test:workflow-fixtures": "node test/workflow-fixtures.test.mjs",
    "test:workflow-contract": "node test/workflow-contract.test.mjs",
    "test:workflow-permissions": "node --test test/workflow-permissions.test.mjs",
    "test:security-policy": "node --test test/security-policy.test.mjs",
    "test:security-fixtures": "node --test test/security-fixtures.test.mjs",
    "test:core-gates": "node --test test/core-gates.test.mjs",
    "test:coverage-gate": "node --test test/coverage-normalize.test.mjs test/coverage-changed.test.mjs test/coverage-ratchet.test.mjs",
    "test:container-contract": "node --test test/container-contract.test.mjs",
    "test:container-workflow": "node --test test/container-workflow.test.mjs",
    "test:container-evidence": "node --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test test/container-evidence.test.mjs",
    "test:repository-rulesets": "node --test test/repository-rulesets.test.mjs && node scripts/governance/validate-rulesets.mjs",
    "test:codeowners": "node --test test/codeowners.test.mjs && node scripts/governance/audit-codeowners.mjs",
    "test:required-checks": "node --test test/required-checks.test.mjs && node scripts/governance/inspect-default-branch.mjs",
    "test:ruleset-payload": "node --test test/ruleset-payload.test.mjs",
    "test:reporting": "node --experimental-test-coverage --test-coverage-include='scripts/reporting/**' --test-coverage-lines=100 --test-coverage-functions=100 --test test/reporting-contract.test.mjs test/reporting-coverage.test.mjs test/reporting-evidence.test.mjs test/quality-snapshot.test.mjs",
    "coverage:source": "node scripts/coverage/source-inventory.mjs > coverage/source-inventory.json",
    "coverage:normalize": "node scripts/coverage/normalize.mjs --report coverage/coverage-summary.json --output coverage/normalized.json",
    "coverage:changed": "node scripts/coverage/evaluate.mjs --report coverage/normalized.json --base \"$COVERAGE_BASE\" --head \"$COVERAGE_HEAD\"",
    "coverage:ratchet": "node scripts/coverage/ratchet.mjs --report coverage/normalized.json --baseline coverage-baselines/current.json",
    "test": "pnpm run test:runtime-contract && pnpm run test:registry-auth && pnpm run test:quality-script-contract && pnpm run test:quality-tools-contract && pnpm run test:core-gates && pnpm run test:workflow-contract && pnpm run test:workflow-fixtures && pnpm run test:coverage-gate",
    "test:quality-tools-contract": "node --test test/quality-tools-contract.test.mjs",
    "quality:check": "pnpm run format:check && pnpm run lint:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tktco/node-actionlint": "1.6.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  }
}
