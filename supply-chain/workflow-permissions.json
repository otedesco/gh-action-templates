              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            }
          },
          "remediation": "Keep public quality checks read-only and do not inherit repository secrets."
        },
        ".github/workflows/release-packages.yml": {
          "events": ["workflow_dispatch", "push"],
