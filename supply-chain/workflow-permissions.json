{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "description": "OPS-183 least-privilege GitHub Actions permission and secret policy",
  "repositories": {
    "gh-action-templates": {
      "path": ".",
      "workflows": {
        ".github/workflows/lint-and-test.yml": {
          "events": ["workflow_call"],
          "workflowPermissions": { "contents": "read" },
          "declaredSecrets": ["NPM_TOKEN"],
          "jobs": {
            "lint-and-test": {
              "permissions": { "contents": "read" },
              "allowedSecrets": ["NPM_TOKEN"],
              "forbiddenSecrets": ["GH_TOKEN", "GITHUB_TOKEN"]
            }
          },
          "remediation": "Keep quality checks read-only and pass NPM_TOKEN only for private dependency installation."
        },
        ".github/workflows/security.yml": {
          "events": ["workflow_call", "pull_request"],
          "workflowPermissions": {},
          "declaredSecrets": ["NPM_TOKEN"],
          "jobs": {
            "codeql": {
              "permissions": { "contents": "read" },
              "allowedSecrets": [],
              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            },
            "dependency-review": {
              "permissions": { "contents": "read", "pull-requests": "read" },
              "allowedSecrets": [],
              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            },
            "secret-scan": {
              "permissions": { "contents": "read" },
              "allowedSecrets": [],
              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            },
            "license": {
              "permissions": { "contents": "read" },
              "allowedSecrets": ["NPM_TOKEN"],
              "forbiddenSecrets": ["GH_TOKEN", "GITHUB_TOKEN"]
            },
            "workflow-security": {
              "permissions": { "contents": "read" },
              "allowedSecrets": [],
              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            },
            "sarif-upload": {
              "permissions": { "contents": "read", "security-events": "write" },
              "allowedSecrets": [],
              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            },
            "aggregate": {
              "permissions": { "contents": "read" },
              "allowedSecrets": [],
              "forbiddenSecrets": ["NPM_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"]
            }
          },
          "remediation": "Keep scanner jobs read-only; grant security-events: write only to SARIF upload and use NPM_TOKEN only for authenticated dependency installation."
        },
        ".github/workflows/release-package.yml": {
          "events": ["workflow_call"],
          "workflowPermissions": {},
          "declaredSecrets": ["NPM_TOKEN"],
          "jobs": {
            "release-packages": {
              "permissions": { "contents": "write", "pull-requests": "write" },
              "allowedSecrets": ["NPM_TOKEN"],
              "forbiddenSecrets": ["GH_TOKEN", "GITHUB_TOKEN"],
              "release": true
            }
          },
          "remediation": "Use the automatic github.token for Changesets and keep NPM_TOKEN scoped to registry authentication."
        },
        ".github/workflows/release-docker-image.yml": {
          "events": ["workflow_call"],
          "workflowPermissions": {},
          "declaredSecrets": ["NPM_TOKEN"],
          "jobs": {
            "release": {
              "permissions": { "contents": "read", "packages": "write" },
              "allowedSecrets": ["NPM_TOKEN"],
              "forbiddenSecrets": ["GH_TOKEN", "GITHUB_TOKEN"],
              "release": true
            }
          },
          "remediation": "Use packages: write for GHCR and keep NPM_TOKEN scoped to the BuildKit private-package input."
        }
      }
    },
    "commons": {
      "path": "../commons",
      "workflows": {
        ".github/workflows/quality-checks.yml": {
          "events": ["workflow_call", "pull_request"],
