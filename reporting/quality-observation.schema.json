{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "commit",
    "workflowSha",
    "check",
    "family",
    "outcome",
    "occurredAt",
    "details"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflowSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "check": { "type": "string", "minLength": 1 },
    "family": { "enum": ["core", "coverage", "security", "release"] },
    "outcome": { "enum": ["success", "failure", "cancelled", "skipped", "unavailable"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["runId", "runUrl", "artifactUrl", "sha256"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "runUrl": { "type": "string", "format": "uri" },
        "artifactUrl": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "details": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "unavailable" } } },
      "then": {},
      "else": { "required": ["source"] }
    }
  ]
}
